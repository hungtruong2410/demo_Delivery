<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Kết quả tìm kiếm</title>

    <style>
        body { padding: 25px; font-family: Arial; }
        .title { font-size: 22px; margin-bottom: 20px; font-weight: bold; }

        .grid {
            display: flex;
            flex-wrap: wrap;
            gap: 25px;
        }

        .card {
            width: 230px;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 15px;
            transition: 0.2s;
        }

        .card:hover {
            transform: scale(1.03);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .card img {
            width: 100%;
            height: 150px;
            border-radius: 8px;
            object-fit: cover;
        }

        .btn {
            padding: 6px 12px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            margin-top: 8px;
            font-size: 14px;
        }

        .btn-primary {
            background: #ff6600;
            color: white;
        }

        .btn-pay {
            background: #28a745;
            color: white;
        }

        .btn-home {
            background: #007bff;
            color: white;
            padding: 10px 14px;
            display: inline-block;
            margin-bottom: 20px;
            border-radius: 6px;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <a href="/homepage" class="btn-home">🏠 Trang chủ</a>

    <div class="title">Kết quả tìm kiếm cho: "<%= keyword %>"</div>

    <% if (products.length === 0) { %>

        <p>Không tìm thấy sản phẩm phù hợp.</p>

    <% } else { %>

        <div class="grid">

            <% products.forEach(p => { %>

                <div class="card">

                    <img src="/images/dish/<%= p.item_img %>" alt="<%= p.item_name %>">

                    <h3><%= p.item_name %></h3>
                    <p><%= p.item_price %> VND</p>

                    <button class="btn btn-primary js-add-to-cart"
                        data-id="<%= p.item_id %>">
                        + Thêm vào giỏ
                    </button>

                    <button class="btn btn-pay"
                        onclick='payNow(<%= p.item_id %>)'>
                        💳 Thanh toán ngay
                    </button>

                </div>

            <% }) %>

        </div>

    <% } %>

    <script>
        // ADD TO CART FUNCTION
        function addToCart(id) {
            // Hiệu ứng UX: Báo đang xử lý
            console.log("Đang gửi yêu cầu thêm vào giỏ...");

            fetch("/add-to-cart", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ item_id: id })
            })
            .then(res => res.json())
            .then(data => {
                // --- QUAN TRỌNG: Kiểm tra server trả về success hay không ---
                if (data.success) {
                    alert("✅ " + data.message);
                } else {
                    // Nếu lỗi (ví dụ: chưa đăng nhập), nó sẽ báo ở đây
                    alert("❌ Lỗi: " + data.message);
                }
            })
            .catch(err => {
                console.error("Lỗi:", err);
                alert("⚠️ Lỗi kết nối Server! (Xem Console)");
            });
        }

        // EVENT LISTENER
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll(".js-add-to-cart").forEach(btn => {
                btn.addEventListener("click", function () {
                    const id = this.dataset.id;
                    addToCart(Number(id));
                });
            });
        });

        // PAY NOW FUNCTION
        function payNow(id) {
            window.location.href = "/checkout-now?item_id=" + id;
        }
    </script>

</body>
</html>