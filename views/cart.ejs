                                        style="color: #ff8243;
padding: 4px 8px;"><b><i>
                                                <%= username %>
                                            </i></b></button></label>
    
                            <div id="myDropdown" class="dropdown-content">
                                    <a href="/myorders">My Orders</a>
                                
    <a href="/settings">Settings</a>
